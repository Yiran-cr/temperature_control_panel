# =====================================================
# 温度显示模板 · 网关环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 数据库连接完全由此文件（或宿主环境变量）配置，代码内无硬编码
# =====================================================

# ---------- 网关服务 ----------
PORT=4000

# ---------- JWT 鉴权 ----------
# 生产环境务必改为强随机值：openssl rand -hex 32
AUTH_SECRET=change-me-in-production-at-least-16-chars
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
TOKEN_TTL_SEC=43200

# ---------- 数据库连接（部署时按实际 TDengine 环境配置）----------
# TDengine REST 地址（如 http://<host>:6041）
TDENGINE_BASE_URL=http://your-tdengine-host:6041
# TDengine 认证头（用户名:密码 Base64，例如 root:taosdata → Basic cm9vdDp0YW9zZGF0YQ==）
TDENGINE_AUTH=Basic cm9vdDp0YW9zZGF0YQ==
# 数据库名 / 超级表名
TDENGINE_DATABASE=your_database
TDENGINE_STABLE=your_stable_table
# 温度字段名（可用 DESCRIBE <表名> 查看实际结构）
TDENGINE_TEMP_FIELD=temperature_val
# 时间戳字段名（TDengine 默认 ts）
TDENGINE_TS_FIELD=ts

# 实时轮询推送间隔（毫秒）
POLL_INTERVAL_MS=1000

# ---------- 模板化显示配置（不同用户按需覆盖）----------
STORAGE_ID=cold-storage-01
STORAGE_NAME=冷库
