# ========== 数据源切换 ==========
# mock    = 模拟数据（默认，无需数据库，开箱即用）
# gateway = 后端网关（数据库连接配置在 server/.env）
# 浏览器不再直连数据库
VITE_DATA_SOURCE=mock

# 兼容旧配置（仅在未设置 VITE_DATA_SOURCE 时生效）
VITE_USE_MOCK=true

# ========== 网关配置（VITE_DATA_SOURCE=gateway 时生效）==========
# 后端网关地址（JWT + WebSocket 实时推送）；生产构建传空串走 nginx 同源反代
VITE_GATEWAY_BASE_URL=http://localhost:4000
# 网关登录凭证（与 server/.env 的 AUTH_USERNAME / AUTH_PASSWORD 对应）
VITE_GATEWAY_USERNAME=admin
VITE_GATEWAY_PASSWORD=admin

# ========== 模板化显示配置 ==========
# 页面标题
VITE_APP_TITLE=冷库温度监控系统
# 冷库唯一 ID
VITE_STORAGE_ID=cold-storage-01
# 冷库显示名称
VITE_STORAGE_NAME=冷库
