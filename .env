# ========== 数据源切换 ==========
# false = 使用真实 TDengine 数据库
# true  = 使用 Mock 模拟数据（默认）
VITE_USE_MOCK=false

# 数据源优先级高于 VITE_USE_MOCK：
# mock | tdengine | gateway
VITE_DATA_SOURCE=gateway

# ========== TDengine 连接配置 ==========
# Vite 代理目标地址（开发环境使用）
VITE_TDENGINE_TARGET=http://119.29.100.108:6041

# TDengine REST API 基础路径（开发环境走 Vite 代理 /api/tdengine）
# 如果生产部署有自己的反向代理，修改此处
VITE_TDENGINE_BASE_URL=/api/tdengine

# TDengine 认证信息（用户名:密码 Base64，这里是 root:taosdata）
VITE_TDENGINE_AUTH=Basic cm9vdDp0YW9zZGF0YQ==

# TDengine 数据库名
VITE_TDENGINE_DATABASE=scada

# 超级表名
VITE_TDENGINE_STABLE=equ_refrigerator

# 温度字段名（请根据实际超级表结构修改）
# DESCRIBE scada.equ_refrigerator 实际返回的温度字段为 temperature_val (FLOAT)
VITE_TDENGINE_TEMP_FIELD=temperature_val

# 时间戳字段名（TDengine 默认 ts，一般不用改）
VITE_TDENGINE_TS_FIELD=ts

# 实时轮询间隔（毫秒），REST API 无法真正订阅，用轮询模拟
VITE_TDENGINE_POLL_INTERVAL=1000

# ========== 网关配置（VITE_DATA_SOURCE=gateway 时生效）==========
# 后端网关地址（JWT + WebSocket 实时推送）
VITE_GATEWAY_BASE_URL=http://localhost:4000
# 网关登录凭证（与 server/.env 的 AUTH_USERNAME / AUTH_PASSWORD 对应）
VITE_GATEWAY_USERNAME=admin
VITE_GATEWAY_PASSWORD=admin
