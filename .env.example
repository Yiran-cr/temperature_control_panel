# =====================================================
# 温度显示模板 · 前端环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 本模板可被不同用户复用，以下配置均可按部署场景覆盖
# =====================================================

# ---------- 数据源切换 ----------
# mock    = 模拟数据（演示 / 无后端，无需任何数据库，开箱即用）
# gateway = 后端网关（JWT + WebSocket，生产推荐；数据库连接配置在 server/.env）
# 说明：浏览器不再直连数据库，凭据只存在于网关服务端。
VITE_DATA_SOURCE=mock

# 兼容旧配置：仅在未设置 VITE_DATA_SOURCE 时生效
VITE_USE_MOCK=true

# ---------- 网关连接（VITE_DATA_SOURCE=gateway 时生效）----------
# 网关地址：开发环境填 http://localhost:4000；生产构建传空串走 nginx 同源反代
VITE_GATEWAY_BASE_URL=http://localhost:4000
# 网关登录凭证（需与 server/.env 的 AUTH_USERNAME / AUTH_PASSWORD 一致）
VITE_GATEWAY_USERNAME=admin
VITE_GATEWAY_PASSWORD=admin

# ---------- 模板化显示配置（不同用户按需覆盖）----------
# 页面标题
VITE_APP_TITLE=冷库温度监控系统
# 冷库唯一 ID（网关侧按此标识过滤数据时需保持一致）
VITE_STORAGE_ID=cold-storage-01
# 冷库显示名称（页面展示）
VITE_STORAGE_NAME=冷库
